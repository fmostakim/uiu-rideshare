# Local API port (ignored on Vercel)
PORT=5000

# Allowed CORS origin. On Vercel the frontend and API share a domain.
CORS_ORIGIN=http://localhost:5173

# Leave blank to use the in-memory dummy store.
# Set it to switch to MongoDB — nothing else needs to change.
# Example: mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB=uiu_rideshare

# REQUIRED in production — used to sign auth tokens.
JWT_SECRET=change-me-to-a-long-random-string
